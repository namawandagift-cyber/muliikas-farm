# Google Apps Script Web App Deployment URL
# Follow instructions in README.md to deploy apps-script/Code.gs
VITE_APPS_SCRIPT_URL=

# Google OAuth 2.0 Web Client ID (from Google Cloud Console -> APIs & Services -> Credentials)
# Do NOT place client secrets here. Only the public Web Client ID.
# Example: 123456789012-abc123xyz456.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=

